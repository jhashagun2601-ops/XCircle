# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE AUTHENTICATION & GOOGLE OAUTH
# 1. Provide your Supabase project URL and public Anon key:
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# 2. To enable Google OAuth in Supabase:
# - Go to your Supabase project dashboard -> Authentication -> Providers -> Google.
# - Turn ON Google provider.
# - Provide your Google Cloud OAuth Client ID & Secret.
# - Add your App callback URL: <APP_URL>/auth/callback or <VITE_SUPABASE_URL>/auth/v1/callback
